FROM node:24.20.0-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e AS build

RUN corepack enable && corepack prepare pnpm@10.12.1 --activate
WORKDIR /workspace

COPY pnpm-workspace.yaml package.json turbo.json tsconfig.json pnpm-lock.yaml ./
# 루트 package의 prepare가 이 스크립트를 실행하므로 없으면 pnpm install 자체가 죽는다.
# 스크립트는 Git metadata가 없는 이미지 빌드에서 스스로 아무 것도 하지 않는다.
COPY tools/git ./tools/git
COPY packages/domain ./packages/domain
COPY packages/contracts ./packages/contracts
COPY packages/db ./packages/db
COPY apps/server ./apps/server

RUN pnpm install --frozen-lockfile --strict-peer-dependencies --filter @eatbid/server...
RUN pnpm --filter @eatbid/server build \
    && pnpm --filter @eatbid/server deploy --prod --legacy /runtime

FROM gcr.io/distroless/nodejs24-debian13:nonroot@sha256:774b7d020b24214835769e24c3544835526cd0288f0b094eae48e8b2c2429a79 AS runtime

ARG GIT_SHA=unknown
LABEL org.opencontainers.image.revision=$GIT_SHA
ENV BUILD_SHA=$GIT_SHA \
    NODE_ENV=production \
    PORT=4400
WORKDIR /app

COPY --from=build --chown=65532:65532 /runtime ./

USER 65532:65532
EXPOSE 4400
ENTRYPOINT ["/nodejs/bin/node"]
CMD ["dist/main.js"]
