{
  "name": "eat-bid-service",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": "24.20.0",
    "pnpm": "10.12.1"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "architecture:check": "node tools/architecture/check-stack-docs.mjs && pnpm quality:check",
    "quality:check": "node tools/quality/check-test-names.mjs",
    "test:quality": "node --test tools/architecture/*.test.mjs tools/quality/*.test.mjs",
    "db:generate": "pnpm --filter @eatbid/db db:generate",
    "db:check": "pnpm --filter @eatbid/db db:check",
    "db:migrate": "pnpm --filter @eatbid/db db:migrate",
    "dataplane:test": "uv run --project apps/dataplane pytest apps/dataplane/tests",
    "dataplane:lint": "uv run --project apps/dataplane ruff check apps/dataplane/src apps/dataplane/tests",
    "dataplane:typecheck": "uv run --project apps/dataplane pyright apps/dataplane/src",
    "test": "pnpm test:quality && bun test apps/web/src packages/shared/src packages/db/src --timeout 30000 && pnpm --filter @eatbid/contracts test && pnpm --filter @eatbid/domain test && pnpm --filter @eatbid/server test"
  },
  "devDependencies": {
    "turbo": "2.10.12"
  }
}
