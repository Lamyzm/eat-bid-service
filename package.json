{
  "name": "eat-bid-service",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": "24.20.0",
    "pnpm": "10.12.1"
  },
  "pnpm": {
    "overrides": {
      "sharp": "^0.35.3",
      "multer": "2.3.0",
      "esbuild": "0.28.2"
    }
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "architecture:check": "node tools/architecture/run-checks.mjs",
    "architecture:check:changed": "node tools/architecture/run-checks.mjs --changed",
    "architecture:erd:write": "node tools/architecture/generate-db-erd.mjs --write",
    "source-fields:write": "node tools/architecture/generate-source-field-index.mjs",
    "lint:web-boundaries": "node tools/architecture/check-web-boundaries.mjs",
    "lint:region-vocabulary": "node tools/architecture/check-region-vocabulary.mjs",
    "lint:endpoints": "node tools/architecture/check-http-operations.mjs && node tools/architecture/check-contract-client-exports.mjs",
    "review:context": "node tools/review/build-review-context.mjs",
    "review:ai": "node tools/review/ai-advisory.mjs",
    "review:doctor": "node tools/review/review-doctor.mjs",
    "agent:skills:check": "node tools/agent-config/sync-skills.mjs --check",
    "agent:skills:write": "node tools/agent-config/sync-skills.mjs --write",
    "agent:doctor": "node tools/agent-config/agent-doctor.mjs",
    "agent:eval": "node tools/agent-config/agent-eval.mjs",
    "quality:check": "node tools/architecture/run-checks.mjs --only test-names,korean-comments,docs",
    "test:quality": "node --test tools/architecture/*.test.mjs tools/quality/*.test.mjs tools/git/*.test.mjs && uv run --project apps/dataplane pytest tools/quality/test_check_python_semantic_values.py -q",
    "contracts:generate": "pnpm --filter @eatbid/contracts contracts:generate",
    "contracts:check": "pnpm --filter @eatbid/contracts contracts:check",
    "contracts:python:generate": "uv run --project apps/dataplane python apps/dataplane/scripts/generate_contract_models.py --write",
    "contracts:python:check": "uv run --project apps/dataplane python apps/dataplane/scripts/generate_contract_models.py --check",
    "workflow:test": "node --test tools/agent-workflow/*.test.mjs",
    "workflow:doctor": "node tools/agent-workflow/cli.mjs doctor",
    "workflow:doctor:infisical": "node tools/agent-workflow/infisical.mjs doctor",
    "workflow:claim": "node tools/agent-workflow/infisical.mjs claim",
    "workflow:issue": "node tools/agent-workflow/infisical.mjs issue",
    "workflow:issues": "node tools/agent-workflow/infisical.mjs issue list",
    "workflow:release": "node tools/agent-workflow/cli.mjs release",
    "workflow:release:review": "node tools/agent-workflow/infisical.mjs release --review",
    "workflow:session": "node tools/agent-workflow/cli.mjs session",
    "workflow:recover-lock": "node tools/agent-workflow/cli.mjs recover-lock",
    "workflow:worktree": "node tools/agent-workflow/cli.mjs worktree",
    "workflow:sync": "node tools/agent-workflow/infisical.mjs sync",
    "db:generate": "pnpm --filter @eatbid/db db:generate",
    "db:check": "pnpm --filter @eatbid/db db:check",
    "db:migrate": "pnpm --filter @eatbid/db db:migrate",
    "dataplane:test": "uv run --project apps/dataplane pytest apps/dataplane/tests",
    "dataplane:lint": "uv run --project apps/dataplane ruff check apps/dataplane/src apps/dataplane/tests apps/dataplane/scripts",
    "dataplane:typecheck": "uv run --project apps/dataplane pyright apps/dataplane/src apps/dataplane/scripts",
    "test": "pnpm test:quality && pnpm --filter @eatbid/web test && pnpm --filter @eatbid/db test && pnpm --filter @eatbid/contracts test && pnpm --filter @eatbid/domain test && pnpm --filter @eatbid/server test",
    "prepare": "node tools/git/configure-hooks.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "turbo": "2.10.12"
  }
}
