{
  "components": {
    "schemas": {
      "Auction": {
        "additionalProperties": false,
        "description": "Canonical auction revision with source provenance.",
        "properties": {
          "announcedAt": {
            "format": "date-time",
            "maxLength": 35,
            "nullable": true,
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "type": "string"
          },
          "auctionId": {
            "maxLength": 19,
            "pattern": "^[1-9][0-9]*$",
            "type": "string"
          },
          "baseAmount": {
            "maxLength": 19,
            "nullable": true,
            "pattern": "^(?:0|[1-9][0-9]{0,15})\\.[0-9]{2}$",
            "type": "string"
          },
          "currency": {
            "pattern": "^[A-Z]{3}$",
            "type": "string"
          },
          "deadlineAt": {
            "format": "date-time",
            "maxLength": 35,
            "nullable": true,
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "type": "string"
          },
          "displayBidNumber": {
            "maxLength": 128,
            "minLength": 1,
            "nullable": true,
            "type": "string"
          },
          "openedAt": {
            "format": "date-time",
            "maxLength": 35,
            "nullable": true,
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "type": "string"
          },
          "plannedAmount": {
            "maxLength": 19,
            "nullable": true,
            "pattern": "^(?:0|[1-9][0-9]{0,15})\\.[0-9]{2}$",
            "type": "string"
          },
          "provenance": {
            "additionalProperties": false,
            "properties": {
              "contentSha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "externalBidId": {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              "normalizedRecordId": {
                "maxLength": 19,
                "pattern": "^[1-9][0-9]*$",
                "type": "string"
              },
              "observationId": {
                "maxLength": 19,
                "pattern": "^[1-9][0-9]*$",
                "type": "string"
              },
              "sourceSystem": {
                "maxLength": 64,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "sourceSystem",
              "externalBidId",
              "observationId",
              "normalizedRecordId",
              "contentSha256"
            ],
            "type": "object"
          },
          "revisionId": {
            "maxLength": 19,
            "pattern": "^[1-9][0-9]*$",
            "type": "string"
          },
          "status": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "auctionId",
          "revisionId",
          "title",
          "status",
          "displayBidNumber",
          "announcedAt",
          "deadlineAt",
          "openedAt",
          "baseAmount",
          "plannedAmount",
          "currency",
          "provenance"
        ],
        "type": "object"
      },
      "LiveHealth": {
        "additionalProperties": false,
        "description": "The server process can handle HTTP work.",
        "properties": {
          "status": {
            "enum": [
              "live"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "ProblemCode": {
        "enum": [
          "VALIDATION_ERROR",
          "UNAUTHENTICATED",
          "FORBIDDEN",
          "NOT_FOUND",
          "AUCTION_NOT_FOUND",
          "CONFLICT",
          "RATE_LIMITED",
          "DEPENDENCY_UNAVAILABLE",
          "INTERNAL_ERROR"
        ],
        "type": "string"
      },
      "ProblemDetails": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ProblemCode"
          },
          "requestId": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "maximum": 599,
            "minimum": 400,
            "type": "integer"
          },
          "title": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "type": {
            "format": "uri",
            "maxLength": 256,
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "requestId"
        ],
        "type": "object"
      },
      "ReadyHealth": {
        "additionalProperties": false,
        "description": "The server is accepting application work.",
        "properties": {
          "status": {
            "enum": [
              "ready"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Bounded canonical HTTP contracts for the eatbid server.",
    "title": "eatbid API",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/v1/auctions/{auctionId}": {
      "get": {
        "operationId": "findAuction",
        "parameters": [
          {
            "example": "9007199254740993",
            "in": "path",
            "name": "auctionId",
            "required": true,
            "schema": {
              "pattern": "^[1-9][0-9]*$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Auction"
                }
              }
            },
            "description": "Canonical auction"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Invalid auction ID"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Auction not found"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unexpected server defect"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Database unavailable"
          }
        },
        "summary": "Find a canonical auction",
        "tags": [
          "procurement"
        ]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "healthLive",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveHealth"
                }
              }
            },
            "description": "Process is live"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unexpected server defect"
          }
        },
        "summary": "Process liveness",
        "tags": [
          "operations"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "healthReady",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyHealth"
                }
              }
            },
            "description": "Application is ready"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unexpected server defect"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Application dependency is unavailable"
          }
        },
        "summary": "Application readiness",
        "tags": [
          "operations"
        ]
      }
    }
  }
}
