{
  "components": {
    "schemas": {
      "LiveHealth": {
        "additionalProperties": false,
        "description": "The server process can handle HTTP work.",
        "properties": {
          "status": {
            "enum": [
              "live"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "ProblemCode": {
        "enum": [
          "VALIDATION_ERROR",
          "UNAUTHENTICATED",
          "FORBIDDEN",
          "NOT_FOUND",
          "CONFLICT",
          "RATE_LIMITED",
          "DEPENDENCY_UNAVAILABLE",
          "INTERNAL_ERROR"
        ],
        "type": "string"
      },
      "ProblemDetails": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ProblemCode"
          },
          "requestId": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "maximum": 599,
            "minimum": 400,
            "type": "integer"
          },
          "title": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "type": {
            "format": "uri",
            "maxLength": 256,
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "requestId"
        ],
        "type": "object"
      },
      "ReadyHealth": {
        "additionalProperties": false,
        "description": "The server is accepting application work.",
        "properties": {
          "status": {
            "enum": [
              "ready"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Bounded canonical HTTP contracts for the eatbid server.",
    "title": "eatbid API",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "healthLive",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveHealth"
                }
              }
            },
            "description": "Process is live"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unexpected server defect"
          }
        },
        "summary": "Process liveness",
        "tags": [
          "operations"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "healthReady",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyHealth"
                }
              }
            },
            "description": "Application is ready"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unexpected server defect"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Application dependency is unavailable"
          }
        },
        "summary": "Application readiness",
        "tags": [
          "operations"
        ]
      }
    }
  }
}
