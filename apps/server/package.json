{
  "name": "@eatbid/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "predev": "tsc -p tsconfig.build.json",
    "dev": "concurrently --kill-others-on-fail --names tsc,node \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --enable-source-maps dist/main.js\"",
    "dev:smoke": "bun test tools/dev-smoke.test.ts --timeout 30000",
    "start": "node --enable-source-maps dist/main.js",
    "test": "bun test src tools --timeout 30000",
    "compatibility:node": "node dist/bootstrap/compatibility-probe.js",
    "architecture:check": "tsc -p tsconfig.tools.json && bun tools/check-architecture.ts",
    "inventory:legacy": "bun tools/inventory-legacy-routes.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "effect": "4.0.0-rc.112",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.1",
    "@types/node": "24.13.3",
    "concurrently": "10.0.5",
    "typescript": "5.9.3"
  }
}
