{
  "name": "@eatbid/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @eatbid/domain build && pnpm --filter @eatbid/contracts build",
    "dev": "next dev",
    "prebuild": "pnpm --filter @eatbid/domain build && pnpm --filter @eatbid/contracts build",
    "build": "next build",
    "start": "next start",
    "cleanup": "node scripts/cleanup.js",
    "pretypecheck": "pnpm --filter @eatbid/domain build && pnpm --filter @eatbid/contracts build",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "bun test src --timeout 30000",
    "pretest:e2e:foundation": "pnpm --filter @eatbid/domain build && pnpm --filter @eatbid/contracts build",
    "test:e2e:foundation": "playwright test frontend-foundation.spec.ts",
    "pretest:e2e:decision": "pnpm --filter @eatbid/domain build && pnpm --filter @eatbid/contracts build",
    "test:e2e:decision": "playwright test decision-screen.spec.ts",
    "pretest:e2e:today": "pnpm --filter @eatbid/domain build && pnpm --filter @eatbid/contracts build",
    "test:e2e:today": "playwright test today-screen.spec.ts",
    "pretest:e2e:cache": "pnpm --filter @eatbid/domain build && pnpm --filter @eatbid/contracts build",
    "test:e2e:cache": "playwright test --config playwright.cache.config.ts",
    "pretest:e2e:auth": "pnpm --filter @eatbid/domain build && pnpm --filter @eatbid/contracts build && pnpm --filter @eatbid/db build",
    "test:e2e:auth": "cd ../server && bun ../web/scripts/auth-e2e.ts",
    "pretest:e2e:own-bid": "pnpm --filter @eatbid/domain build && pnpm --filter @eatbid/contracts build && pnpm --filter @eatbid/db build",
    "test:e2e:own-bid": "cd ../server && bun ../web/scripts/own-bid-e2e.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix && bun format",
    "lint:strict": "pnpm --dir ../.. lint:web-boundaries && pnpm --dir ../.. lint:endpoints && oxlint --deny-warnings",
    "format": "oxfmt --write . '!**/*.md' '!**/*.mdc' '!**/*.mdx' '!**/*.yml' '!**/*.yaml'",
    "format:check": "oxfmt --check . '!**/*.md' '!**/*.mdc' '!**/*.mdx' '!**/*.yml' '!**/*.yaml'"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@eatbid/contracts": "workspace:*",
    "@eatbid/domain": "workspace:*",
    "@sentry/nextjs": "^10.45.0",
    "@shadcn/react": "^0.2.1",
    "@tabler/icons-react": "^3.40.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-query-devtools": "5.102.8",
    "better-auth": "1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "leaflet": "^1.9.4",
    "lightweight-charts": "^5.2.1",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "nuqs": "^2.8.9",
    "postcss": "8.5.25",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-dropzone": "^14.4.1",
    "react-leaflet": "^5.0.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.8.0",
    "server-only": "0.0.1",
    "sharp": "^0.35.3",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "catalog:",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@happy-dom/global-registrator": "20.12.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/bun": "1.2.22",
    "@types/leaflet": "^1.9.22",
    "@types/node": "22.10.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sort-by": "^1.2.3",
    "@types/uuid": "^10.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "happy-dom": "20.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "!(scripts)/**/*.{js,jsx,tsx,ts,css,less,scss,sass}": [
      "oxfmt --write"
    ]
  }
}
