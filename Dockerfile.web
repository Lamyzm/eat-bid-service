FROM node:24-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e AS build

RUN corepack enable && corepack prepare pnpm@10.12.1 --activate
WORKDIR /workspace

COPY pnpm-workspace.yaml package.json turbo.json tsconfig.json pnpm-lock.yaml ./
COPY packages ./packages
COPY apps/web ./apps/web

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @eatbid/shared build
ENV BUILD_STANDALONE=true
RUN pnpm --filter @eatbid/web build

FROM gcr.io/distroless/nodejs24-debian13:nonroot@sha256:774b7d020b24214835769e24c3544835526cd0288f0b094eae48e8b2c2429a79 AS runtime

ARG GIT_SHA=unknown
LABEL org.opencontainers.image.revision=$GIT_SHA
ENV BUILD_SHA=$GIT_SHA \
    NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0
WORKDIR /app

COPY --from=build --chown=65532:65532 /workspace/apps/web/.next/standalone ./
COPY --from=build --chown=65532:65532 /workspace/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=65532:65532 /workspace/apps/web/public ./apps/web/public

USER 65532:65532
EXPOSE 3000
ENTRYPOINT ["/nodejs/bin/node"]
CMD ["apps/web/server.js"]
